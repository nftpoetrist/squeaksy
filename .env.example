# Supabase → Project Settings → API (anon key herkese açık olabilir; service_role key'i ASLA buraya koymayın)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Yayın adresi (paylaşım önizlemesi için, sonda / olmadan)
VITE_SITE_URL=https://YOUR-DOMAIN

# WalletConnect (telefon cüzdanları): https://cloud.reown.com → Project ID (herkese açık değer; alan adı listesine squeaksy.xyz + localhost eklenmeli)
VITE_WALLETCONNECT_PROJECT_ID=
